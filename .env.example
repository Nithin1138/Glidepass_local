# ------------------------------------------------------------------------------
# 1. AI PROVIDERS (Gemini & Groq)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Gemini 2.5 Flash, 1.5 Flash, 1.5 Pro)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Groq Cloud API Key (Llama 3.3 70B, Qwen 2.5 72B)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=""

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@ep-your-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ------------------------------------------------------------------------------
# 3. DAEMON & TELEMETRY SETTINGS
# ------------------------------------------------------------------------------
LANPAD_TELEMETRY_DISABLE="0"
