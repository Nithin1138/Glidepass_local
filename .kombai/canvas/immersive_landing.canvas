 </div>\n            <div class=\"flex justify-between items-center text-lg\" data-kid=\"151\">\n              <span class=\"text-gray-500 font-medium\" data-kid=\"152\">Analytics Add-on</span>\n              <span class=\"font-black\" data-kid=\"153\">$12.00</span>\n            </div>\n            <div class=\"flex justify-between items-center text-lg\" data-kid=\"154\">\n              <span class=\"text-gray-500 font-medium\" data-kid=\"155\">AI Intelligence</span>\n              <span class=\"font-black\" data-kid=\"156\">$19.00</span>\n            </div>\n          </div>\n\n          <div class=\"border-t-4 border-dashed border-gray-100 pt-8 flex justify-between items-end mb-12\" data-kid=\"157\">\n             <div data-kid=\"158\">\n               <p class=\"text-gray-400 text-sm font-bold uppercase mb-1\" data-kid=\"159\">Total Monthly</p>\n               <h3 class=\"font-['Rubik'] text-5xl font-black text-gray-900\" data-kid=\"160\">$80.00</h3>\n             </div>\n             <p class=\"text-blue-500 font-bold\" data-kid=\"161\">Save 20% yearly</p>\n          </div>\n\n          <button class=\"w-full clay-blue text-white font-black py-6 rounded-3xl text-xl hover:scale-[1.05] transition-all\" data-kid=\"162\">\n            ACTIVATE BUILD\n          </button>\n\n          \n          <div class=\"flex justify-center gap-4 mt-8\" data-kid=\"163\">\n             <div class=\"w-12 h-12 clay-card flex items-center justify-center cursor-pointer hover:bg-white transition-colors\" data-kid=\"164\">\n               <i class=\"ti ti-help text-gray-400 text-xl\" data-kid=\"165\"></i>\n             </div>\n             <div class=\"w-12 h-12 clay-card flex items-center justify-center cursor-pointer hover:bg-white transition-colors\" data-kid=\"166\">\n               <i class=\"ti ti-message-dots text-gray-400 text-xl\" data-kid=\"167\"></i>\n             </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"h-[800px] bg-[#468FEA] relative overflow-hidden flex items-center justify-center\" data-kid=\"168\">\n    \n    <div class=\"text-center z-10 px-6\" data-kid=\"169\">\n      <h2 class=\"font-['Rubik'] text-6xl md:text-9xl font-black text-white mb-12 tracking-tighter\" data-kid=\"170\">\n        READY TO MOLD<br data-kid=\"171\">THE FUTURE?\n      </h2>\n      <button class=\"clay-orange text-white text-3xl md:text-5xl font-black py-8 md:py-12 px-16 md:px-24 rounded-full hover:scale-105 transition-transform shadow-[0_30px_60px_rgba(242,133,0,0.4)]\" data-kid=\"172\">\n        GET STARTED NOW\n      </button>\n    </div>\n\n    \n    <div class=\"curtain-panel left-0 -translate-x-[42%] border-r-[20px] border-white/30 shadow-[40px_0_80px_rgba(0,0,0,0.2)]\" data-kid=\"173\">\n       <div class=\"ml-auto mr-12 w-10 h-48 clay-card shadow-[inset_4px_4px_8px_rgba(255,255,255,0.8),inset_-4px_-4px_8px_rgba(0,0,0,0.1)] flex items-center justify-center\" data-kid=\"174\">\n         <div class=\"w-2 h-24 bg-gray-300 rounded-full opacity-50\" data-kid=\"175\"></div>\n       </div>\n    </div>\n    <div class=\"curtain-panel right-0 translate-x-[42%] border-l-[20px] border-white/30 flex-row-reverse shadow-[-40px_0_80px_rgba(0,0,0,0.2)]\" data-kid=\"176\">\n       <div class=\"mr-auto ml-12 w-10 h-48 clay-card shadow-[inset_4px_4px_8px_rgba(255,255,255,0.8),inset_-4px_-4px_8px_rgba(0,0,0,0.1)] flex items-center justify-center\" data-kid=\"177\">\n         <div class=\"w-2 h-24 bg-gray-300 rounded-full opacity-50\" data-kid=\"178\"></div>\n       </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"bg-[#EDEAE0] py-20 px-20 border-t border-gray-200/50\" data-kid=\"179\">\n    <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-12\" data-kid=\"180\">\n      <div class=\"flex items-center gap-3\" data-kid=\"181\">\n        <div class=\"w-10 h-10 clay-orange rounded-full\" data-kid=\"182\"></div>\n        <span class=\"font-['Rubik'] font-black text-