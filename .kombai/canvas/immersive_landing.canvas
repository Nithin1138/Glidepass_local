      "html": "\n<div class=\"bg-[#EDEAE0] text-gray-900 font-['DM_Sans'] antialiased\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Rubik:wght@700;900&family=DM+Sans:wght@400;500;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css');\n\n    .clay-card {\n      background: #EDEAE0;\n      border-radius: 40px;\n      box-shadow: \n        20px 20px 40px rgba(0,0,0,0.08), \n        -20px -20px 40px rgba(255,255,255,1),\n        inset 6px 6px 12px rgba(255,255,255,0.9),\n        inset -6px -6px 12px rgba(0,0,0,0.05);\n    }\n\n    .clay-blue {\n      background: #468FEA;\n      box-shadow: \n        16px 16px 32px rgba(70, 143, 234, 0.4),\n        inset 8px 8px 16px rgba(255,255,255,0.3),\n        inset -8px -8px 16px rgba(0,0,0,0.15);\n    }\n\n    .clay-orange {\n      background: #F28500;\n      box-shadow: \n        16px 16px 32px rgba(242, 133, 0, 0.4),\n        inset 10px 10px 20px rgba(255,255,255,0.4),\n        inset -10px -10px 20px rgba(0,0,0,0.2);\n    }\n\n    .clay-switch {\n      width: 72px;\n      height: 36px;\n      background: #D1D5DB;\n      border-radius: 99px;\n      padding: 4px;\n      box-shadow: inset 4px 4px 8px rgba(0,0,0,0.1);\n      position: relative;\n      cursor: pointer;\n      transition: background 0.3s ease;\n    }\n    \n    .clay-switch.active {\n      background: #468FEA;\n    }\n\n    .clay-switch-handle {\n      width: 28px;\n      height: 28px;\n      background: white;\n      border-radius: 99px;\n      box-shadow: 2px 2px 5px rgba(0,0,0,0.1);\n      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n\n    .clay-switch.active .clay-switch-handle {\n      transform: translateX(36px);\n    }\n\n    @keyframes bob {\n      0%, 100% { transform: translateY(0); }\n      50% { transform: translateY(-20px); }\n    }\n    \n    .animate-bob { animation: bob 4s ease-in-out infinite; }\n    .animate-bob-delayed { animation: bob 4s ease-in-out 1s infinite; }\n    .animate-bob-slow { animation: bob 6s ease-in-out 0.5s infinite; }\n\n    .isometric-stack {\n      perspective: 1500px;\n      transform-style: preserve-3d;\n    }\n\n    .slab {\n      width: 320px;\n      height: 220px;\n      position: absolute;\n      border-radius: 32px;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      align-items: center;\n      transform: rotateX(45deg) rotateZ(-35deg);\n      transition: all 0.5s ease;\n    }\n\n    /* Reveal CTA Logic */\n    .curtain-panel {\n      position: absolute;\n      top: 0;\n      width: 50%;\n      height: 100%;\n      background: #EDEAE0;\n      z-index: 20;\n      display: flex;\n      align-items: center;\n    }\n  </style>\n\n  \n  <nav class=\"absolute top-0 left-0 right-0 z-50 px-12 py-8 flex justify-between items-center bg-transparent pointer-events-none\" data-kid=\"2\">\n    <div class=\"clay-card px-6 py-3 pointer-events-auto flex items-center gap-2\" data-kid=\"3\">\n      <div class=\"w-8 h-8 clay-orange rounded-full shadow-[inset_2px_2px_4px_rgba(255,255,255,0.4)]\" data-kid=\"4\"></div>\n      <span class=\"font-['Rubik'] font-black text-xl tracking-tight\" data-kid=\"5\">CLAY</span>\n    </div>\n    <div class=\"clay-card px-8 py-3 pointer-events-auto space-x-8 hidden md:block\" data-kid=\"6\">\n      <a href=\"#\" class=\"font-bold text-gray-600 hover:text-gray-900 transition-colors\" data-kid=\"7\">Product</a>\n      <a href=\"#\" class=\"font-bold text-gray-600 hover:text-gray-900 transition-colors\" data-kid=\"8\">Metrics</a>\n      <a href=\"#\" class=\"font-bold text-gray-600 hover:text-gray-900 transition-colors\" data-kid=\"9\">Pricing</a>\n    </div>\n    <button class=\"clay-blue text-white font-bold px-8 py-3 rounded-full pointer-events-auto hover:scale-105 transition-transform\" data-kid=\"10\">\n      Login\n    </button>\n  </nav>\n\n  \n  <section class=\"min-h-[800px] flex items-center relative overflow-hidden px-20 pt-40 pb-20\" data-kid=\"11\">\n    <div class=\"max-w-7xl mx-auto w-full grid grid-cols-12 gap-12 items-center\" data-kid=\"12\">\n      <div class=\"col-span-12 lg:col-span-6 z-10\" data-kid=\"13\">\n        <h1 class=\"font-['Rubik'] text-6xl lg:text-[115px] font-black text-gray-900 leading-[0.8] tracking-tighter mb-12\" data-kid=\"14\">\n          SOFT<br data-kid=\"15\">BEYOND<br data-kid=\"16\">HARDWARE.\n        </h1>\n        <p class=\"text-2xl text-gray-500 max-w-lg mb-12 leading-relaxed font-medium\" data-kid=\"17\">\n          A physical operating system designed for the digital native. Puffy, tactile, and incredibly responsive.\n        </p>\n        <div class=\"flex gap-6\" data-kid=\"18\">\n          <button class=\"clay-orange text-white font-black py-6 px-12 rounded-full text-xl hover:scale-105 transition-transform\" data-kid=\"19\">\n            START BUILDING\n          </button>\n          <div class=\"clay-card p-6 flex items-center justify-center\" data-kid=\"20\">\n            <i class=\"ti ti-player-play-filled text-gray-400 text-2xl\" data-kid=\"21\"></i>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"col-span-12 lg:col-span-6 relative h-[700px]\" data-kid=\"22\">\n        \n        <div class=\"absolute top-0 right-10 w-80 clay-card p-6 animate-bob\" data-kid=\"23\">\n          <div class=\"flex items-center gap-4 bg-[#EDEAE0] rounded-2xl p-4 shadow-[inset_4px_4px_8px_rgba(0,0,0,0.05),inset_-4px_-4px_8px_rgba(255,255,255,0.8)] border border-white/20\" data-kid=\"24\">\n            <i class=\"ti ti-search text-gray-400 text-xl\" data-kid=\"25\"></i>\n            <span class=\"text-gray-400 font-bold\" data-kid=\"26\">Search everything...</span>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute top-40 left-10 w-72 clay-blue p-8 rounded-[40px] animate-bob-delayed\" data-kid=\"27\">\n           <div class=\"flex items-center gap-4 mb-6\" data-kid=\"28\">\n              <div class=\"w-12 h-12 bg-white/30 rounded-2xl flex items-center justify-center\" data-kid=\"29\">\n                <i class=\"ti ti-bell-filled text-white text-2xl\" data-kid=\"30\"></i>\n              </div>\n              <div class=\"h-3 w-24 bg-white/20 rounded-full\" data-kid=\"31\"></div>\n           </div>\n           <div class=\"space-y-2\" data-kid=\"32\">\n              <div class=\"h-2 w-full bg-white/20 rounded-full\" data-kid=\"33\"></div>\n              <div class=\"h-2 w-2/3 bg-white/20 rounded-full\" data-kid=\"34\"></div>\n           </div>\n        </div>\n\n        \n        <div class=\"absolute bottom-10 right-0 w-80 clay-card p-8 animate-bob-slow\" data-kid=\"35\">\n           <div class=\"flex justify-between items-center mb-6\" data-kid=\"36\">\n             <span class=\"font-bold text-gray-900\" data-kid=\"37\">Project Alpha</span>\n             <span class=\"text-xs font-black uppercase text-orange-500 bg-orange-100 px-3 py-1 rounded-full\" data-kid=\"38\">Active</span>\n           </div>\n           <div class=\"flex items-end gap-1 h-20 mb-4\" data-kid=\"39\">\n              <div class=\"w-full bg-blue-100 rounded-lg h-[30%]\" data-kid=\"40\"></div>\n              <div class=\"w-full bg-blue-200 rounded-lg h-[50%]\" data-kid=\"41\"></div>\n              <div class=\"w-full bg-blue-300 rounded-lg h-[80%]\" data-kid=\"42\"></div>\n              <div class=\"w-full bg-blue-500 rounded-lg h-[60%]\" data-kid=\"43\"></div>\n              <div class=\"w-full bg-blue-400 rounded-lg h-[90%]\" data-kid=\"44\"></div>\n           </div>\n           <div class=\"flex -space-x-3\" data-kid=\"45\">\n              <img src=\"https://i.pravatar.cc/100?u=1\" alt=\"Avatar\" class=\"w-10 h-10 rounded-full border-4 border-[#EDEAE0]\" decoding=\"async\" loading=\"lazy\" data-kid=\"46\">\n              <img src=\"https://i.pravatar.cc/100?u=2\" alt=\"Avatar\" class=\"w-10 h-10 rounded-full border-4 border-[#EDEAE0]\" decoding=\"async\" loading=\"lazy\" data-kid=\"47\">\n              <div class=\"w-10 h-10 rounded-full bg-gray-200 border-4 border-[#EDEAE0] flex items-center justify-center text-xs font-bold\" data-kid=\"48\">+4</div>\n           </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"min-h-[600px] flex items-center bg-[#EDEAE0] overflow-hidden py-24\" data-kid=\"49\">\n    <div class=\"max-w-7xl mx-auto px-20 w-full flex flex-col lg:flex-row items-center gap-24\" data-kid=\"50\">\n      <div class=\"lg:w-1/2\" data-kid=\"51\">\n        <h2 class=\"font-['Rubik'] text-6xl font-black mb-8 leading-tight\" data-kid=\"52\">SOLID AS<br data-kid=\"53\">A SLAB.</h2>\n        <p class=\"text-xl text-gray-500 leading-relaxed mb-10 max-w-md font-medium\" data-kid=\"54\">\n          Forget brittle dashboards. Our metrics are built into physical slabs of data that represent real-world impact.\n        </p>\n        <div class=\"space-y-6\" data-kid=\"55\">\n          <div class=\"flex items-center gap-4\" data-kid=\"56\">\n             <div class=\"w-10 h-10 clay-card flex items-center justify-center\" data-kid=\"57\">\n               <i class=\"ti ti-check text-orange-500\" data-kid=\"58\"></i>\n             </div>\n             <span class=\"font-bold text-gray-700\" data-kid=\"59\">99.9% Physical Uptime</span>\n          </div>\n          <div class=\"flex items-center gap-4\" data-kid=\"60\">\n             <div class=\"w-10 h-10 clay-card flex items-center justify-center\" data-kid=\"61\">\n               <i class=\"ti ti-check text-orange-500\" data-kid=\"62\"></i>\n             </div>\n             <span class=\"font-bold text-gray-700\" data-kid=\"63\">10x Structural Speed</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"lg:w-1/2 h-[600px] relative isometric-stack flex items-center justify-center\" data-kid=\"64\">\n        \n        <div class=\"slab clay-orange\" style=\"transform: rotateX(45deg) rotateZ(-35deg) translateZ(-120px);\" data-kid=\"65\">\n           <span class=\"text-white/70 text-xs font-black uppercase tracking-widest mb-2\" data-kid=\"66\">Impact</span>\n           <span class=\"text-white text-6xl font-black font-['Rubik'] tracking-tighter\" data-kid=\"67\">10X</span>\n        </div>\n        \n        \n        <div class=\"slab clay-blue\" style=\"transform: rotateX(45deg) rotateZ(-35deg) translateZ(0px);\" data-kid=\"68\">\n           <i class=\"ti ti-arrow-down text-white text-8xl\" data-kid=\"69\"></i>\n        </div>\n\n        \n        <div class=\"slab bg-[#D1D5DB] shadow-[20px_20px_40px_rgba(0,0,0,0.15)] border-2 border-white/40\" style=\"transform: rotateX(45deg) rotateZ(-35deg) translateZ(120px);\" data-kid=\"70\">\n           <span class=\"text-gray-500 text-xs font-black uppercase tracking-widest mb-2\" data-kid=\"71\">Legacy</span>\n           <span class=\"text-gray-800 text-4xl font-black font-['Rubik']\" data-kid=\"72\">STALLED</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-20\" data-kid=\"73\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"74\">\n      <div class=\"flex justify-between items-end mb-20\" data-kid=\"75\">\n        <div data-kid=\"76\">\n          <h2 class=\"font-['Rubik'] text-5xl font-black mb-4\" data-kid=\"77\">TACTILE SUITE.</h2>\n          <p class=\"text-xl text-gray-500 font-medium\" data-kid=\"78\">Every tool you need, sculpted to perfection.</p>\n        </div>\n        <button class=\"clay-card px-10 py-5 font-bold hover:bg-gray-50 transition-colors\" data-kid=\"79\">\n          View all features\n        </button>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\" data-kid=\"80\">\n        \n        <div class=\"clay-card h-[600px] overflow-hidden p-0 relative group\" data-kid=\"81\">\n          <video src=\"https://videos.pexels.com/video-files/34327303/14542516_360_640_30fps.mp4\" poster=\"https://images.pexels.com/videos/34327303/pexels-photo-34327303.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=1200&w=630\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover\" data-kid=\"82\"></video>\n          <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-10 text-white\" data-kid=\"83\">\n            <h3 class=\"font-['Rubik'] text-3xl font-black mb-3\" data-kid=\"84\">Fluid Engine</h3>\n            <p class=\"text-lg opacity-80 font-medium\" data-kid=\"85\">Animations that move like liquid clay. Satisfying at every frame.</p>\n          </div>\n        </div>\n\n        \n        <div class=\"space-y-8\" data-kid=\"86\">\n          <div class=\"clay-card p-10 h-[284px] flex flex-col justify-center\" data-kid=\"87\">\n            <div class=\"w-14 h-14 clay-blue rounded-2xl flex items-center justify-center mb-8\" data-kid=\"88\">\n               <i class=\"ti ti-bolt text-white text-3xl\" data-kid=\"89\"></i>\n            </div>\n            <h3 class=\"font-['Rubik'] text-2xl font-black mb-2\" data-kid=\"90\">Instant Sculpt</h3>\n            <p class=\"text-gray-500 font-medium\" data-kid=\"91\">Modify your workspace in real-time with physical drag-and-drop.</p>\n          </div>\n          <div class=\"clay-blue p-10 h-[284px] flex flex-col justify-center !shadow-none rounded-[40px]\" data-kid=\"92\">\n            <h3 class=\"font-['Rubik'] text-3xl font-black mb-4 text-white\" data-kid=\"93\">Unified Core</h3>\n            <p class=\"text-white/80 text-lg font-medium leading-relaxed\" data-kid=\"94\">Centralized database that syncs across all your tactile devices instantly.</p>\n          </div>\n        </div>\n\n        \n        <div class=\"clay-card p-10 h-[600px] flex flex-col relative overflow-hidden\" data-kid=\"95\">\n          <div class=\"mb-auto\" data-kid=\"96\">\n             <div class=\"inline-block px-4 py-2 bg-orange-100 text-orange-600 rounded-full text-sm font-black mb-6\" data-kid=\"97\">NEW UPDATES</div>\n             <h3 class=\"font-['Rubik'] text-4xl font-black mb-6\" data-kid=\"98\">Infinite Canvas</h3>\n             <p class=\"text-gray-500 text-lg leading-relaxed font-medium\" data-kid=\"99\">Your ideas shouldn't be boxed in. Expand your digital world without limits.</p>\n          </div>\n          <div class=\"mt-12 -mx-10 translate-y-20\" data-kid=\"100\">\n             <div class=\"flex gap-4 p-4\" data-kid=\"101\">\n                <div class=\"w-40 h-40 clay-card shrink-0 flex items-center justify-center\" data-kid=\"102\">\n                   <i class=\"ti ti-box text-gray-300 text-6xl\" data-kid=\"103\"></i>\n                </div>\n                <div class=\"w-40 h-40 clay-blue shrink-0 flex items-center justify-center\" data-kid=\"104\">\n                   <i class=\"ti ti-rocket text-white/50 text-6xl\" data-kid=\"105\"></i>\n                </div>\n                <div class=\"w-40 h-40 clay-orange shrink-0 flex items-center justify-center\" data-kid=\"106\">\n                   <i class=\"ti ti-flame text-white/50 text-6xl\" data-kid=\"107\"></i>\n                </div>\n             </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 bg-[#EDEAE0] relative z-10\" data-kid=\"108\">\n    <div class=\"max-w-7xl mx-auto px-20 grid grid-cols-12 gap-16 items-start\" data-kid=\"109\">\n      <div class=\"col-span-12 lg:col-span-7\" data-kid=\"110\">\n        <h2 class=\"font-['Rubik'] text-6xl font-black mb-12\" data-kid=\"111\">BUILD YOUR<br data-kid=\"112\">PLAN.</h2>\n        \n        <div class=\"space-y-6\" data-kid=\"113\">\n          <div class=\"clay-card p-8 flex items-center justify-between hover:scale-[1.02] transition-transform cursor-pointer\" data-kid=\"114\">\n            <div class=\"flex items-center gap-6\" data-kid=\"115\">\n              <div class=\"w-16 h-16 clay-card shrink-0 flex items-center justify-center shadow-[inset_2px_2px_6px_rgba(255,255,255,0.8),inset_-2px_-2px_6px_rgba(0,0,0,0.05)]\" data-kid=\"116\">\n                <i class=\"ti ti-chart-pie-filled text-[#468FEA] text-3xl\" data-kid=\"117\"></i>\n              </div>\n              <div data-kid=\"118\">\n                <h4 class=\"text-xl font-black text-gray-900 font-['Rubik']\" data-kid=\"119\">Advanced Analytics</h4>\n                <p class=\"text-gray-500 font-medium\" data-kid=\"120\">Real-time data streaming & modeling</p>\n              </div>\n            </div>\n            <div class=\"clay-switch active shadow-[4px_4px_8px_rgba(0,0,0,0.05),inset_2px_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"121\">\n              <div class=\"clay-switch-handle shadow-[2px_2px_5px_rgba(0,0,0,0.2)]\" data-kid=\"122\"></div>\n            </div>\n          </div>\n\n          <div class=\"clay-card p-8 flex items-center justify-between hover:scale-[1.02] transition-transform cursor-pointer\" data-kid=\"123\">\n            <div class=\"flex items-center gap-6\" data-kid=\"124\">\n              <div class=\"w-16 h-16 clay-card shrink-0 flex items-center justify-center shadow-[inset_2px_2px_6px_rgba(255,255,255,0.8),inset_-2px_-2px_6px_rgba(0,0,0,0.05)]\" data-kid=\"125\">\n                <i class=\"ti ti-users-group text-[#F28500] text-3xl\" data-kid=\"126\"></i>\n              </div>\n              <div data-kid=\"127\">\n                <h4 class=\"text-xl font-black text-gray-900 font-['Rubik']\" data-kid=\"128\">Team Collaboration</h4>\n                <p class=\"text-gray-500 font-medium\" data-kid=\"129\">Unlimited seats and shared vaults</p>\n              </div>\n            </div>\n            <div class=\"clay-switch shadow-[4px_4px_8px_rgba(0,0,0,0.05),inset_2px_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"130\">\n              <div class=\"clay-switch-handle shadow-[2px_2px_5px_rgba(0,0,0,0.2)]\" data-kid=\"131\"></div>\n            </div>\n          </div>\n\n          <div class=\"clay-card p-8 flex items-center justify-between hover:scale-[1.02] t