      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Fira+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-color: #003153;\n    --primary-glow: #7DF9FF;\n    --cta-accent: #DE3163;\n  }\n\n  body {\n    background-color: var(--bg-color);\n    color: white;\n    font-family: 'Fira Sans', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-heading {\n    font-family: 'Space Grotesk', sans-serif;\n  }\n\n  /* Custom Cursor */\n  #custom-cursor {\n    width: 24px;\n    height: 24px;\n    border: 1.5px solid var(--primary-glow);\n    border-radius: 50%;\n    position: absolute;\n    pointer-events: none;\n    z-index: 1000;\n    transition: transform 0.15s ease-out, width 0.3s ease, height 0.3s ease, background 0.3s ease;\n    transform: translate(-50%, -50%);\n    box-shadow: 0 0 10px rgba(125, 249, 255, 0.4);\n  }\n\n  .cursor-active {\n    width: 48px;\n    height: 48px;\n    background: rgba(125, 249, 255, 0.1);\n    border-width: 2px;\n  }\n\n  /* Section Styles */\n  .spatial-glass {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .glow-text {\n    text-shadow: 0 0 15px rgba(125, 249, 255, 0.5);\n  }\n\n  .cyber-scanlines {\n    background: linear-gradient(to bottom, transparent 50%, rgba(0, 0, 0, 0.1) 50%);\n    background-size: 100% 4px;\n    pointer-events: none;\n    z-index: 100;\n  }\n\n  /* Animations */\n  @keyframes rotate-3d {\n    from { transform: rotateY(0deg) rotateX(10deg); }\n    to { transform: rotateY(360deg) rotateX(10deg); }\n  }\n\n  .animate-rotate-3d {\n    animation: rotate-3d 30s linear infinite;\n  }\n\n  /* Improved Orbiting Logic */\n  @keyframes orbit-rotate {\n    from { transform: rotate(0deg); }\n    to { transform: rotate(360deg); }\n  }\n\n  @keyframes counter-rotate {\n    from { transform: rotate(0deg); }\n    to { transform: rotate(-360deg); }\n  }\n\n  .orbit-wrapper {\n    position: absolute;\n    width: 100%;\n    height: 100%;\n    animation: orbit-rotate var(--duration) linear infinite;\n    transform: rotate(var(--start-angle));\n  }\n\n  /* Custom orbit rotate for each to start from its start-angle */\n  @keyframes orbit-rotate-0 { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }\n  @keyframes orbit-rotate-120 { from { transform: rotate(120deg); } to { transform: rotate(480deg); } }\n  @keyframes orbit-rotate-240 { from { transform: rotate(240deg); } to { transform: rotate(600deg); } }\n  @keyframes orbit-rotate-60 { from { transform: rotate(60deg); } to { transform: rotate(420deg); } }\n  @keyframes orbit-rotate-180 { from { transform: rotate(180deg); } to { transform: rotate(540deg); } }\n  @keyframes orbit-rotate-300 { from { transform: rotate(300deg); } to { transform: rotate(660deg); } }\n\n  .orbital-card {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%) translate(var(--distance), 0);\n  }\n\n  .orbital-card-content {\n    animation: counter-rotate var(--duration) linear infinite;\n  }\n\n  .orbit-wrapper:hover, .orbit-wrapper:hover .orbital-card-content {\n    animation-play-state: paused;\n  }\n\n  .orbital-card:hover {\n    z-index: 100;\n    scale: 1.1;\n  }\n\n  /* Magnetic Button wrapper */\n  .magnetic-btn-wrap {\n    display: inline-block;\n    padding: 20px;\n  }\n\n  /* Peephole Expansion on Scroll Simulation (via hover for interactive feel) */\n  .peephole-parent:hover .peephole-window {\n    width: 100%;\n    height: 100%;\n    border-radius: 0;\n  }\n</style>\n\n<div id=\"custom-cursor\" data-kid=\"1\"></div>\n\n\n<section id=\"hero\" class=\"relative w-full h-[850px] flex items-center px-24 overflow-hidden border-b border-white/5\" data-kid=\"2\">\n  <div class=\"absolute inset-0 cyber-scanlines opacity-20\" data-kid=\"3\"></div>\n  <div class=\"relative z-10 w-full max-w-2xl\" data-kid=\"4\">\n    <h1 class=\"font-heading text-8xl font-bold leading-[0.9] tracking-tighter mb-8\" data-kid=\"5\">\n      THE <span class=\"text-[var(--primary-glow)] glow-text\" data-kid=\"6\">SPATIAL</span><br data-kid=\"7\">\n      CONSENSUS<br data-kid=\"8\">\n      <span class=\"text-white/20\" data-kid=\"9\">LAYER</span>\n    </h1>\n    <p class=\"text-xl text-white/60 max-w-lg mb-12 font-light leading-relaxed\" data-kid=\"10\">\n      A volumetric operating environment for high-frequency data streams. \n      Visualize, orchestrate, and deploy spatial logic across the global edge network.\n    </p>\n    \n    <div class=\"magnetic-btn-wrap\" id=\"mag-hero-wrap\" data-kid=\"11\">\n      <button id=\"mag-hero-btn\" class=\"font-heading px-12 py-5 bg-[var(--cta-accent)] text-white text-xl font-bold rounded-full shadow-[0_0_30px_rgba(222,49,99,0.4)] transition-all duration-300 hover:shadow-[0_0_50px_rgba(222,49,99,0.6)] flex items-center gap-3\" data-kid=\"12\">\n        <span data-kid=\"13\">INITIALIZE ENGINE</span>\n        <i class=\"ti ti-bolt text-2xl\" data-kid=\"14\"></i>\n      </button>\n    </div>\n  </div>\n\n  \n  <div class=\"absolute right-0 top-0 bottom-0 w-[55%] flex items-center justify-center pointer-events-none\" data-kid=\"15\">\n    <div class=\"relative w-[700px] h-[700px]\" data-kid=\"16\">\n      \n      <div class=\"absolute inset-0 bg-[var(--primary-glow)]/10 blur-[150px] rounded-full\" data-kid=\"17\"></div>\n      \n      <div class=\"absolute inset-0 flex items-center justify-center animate-rotate-3d\" data-kid=\"18\">\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lord-berandas/holosphere.svg\" class=\"w-[500px] h-[500px] opacity-70\" style=\"filter: drop-shadow(0 0 50px var(--primary-glow)) brightness(1.2);\" alt=\"Spatial Holosphere\" decoding=\"async\" loading=\"lazy\" data-kid=\"19\">\n      </div>\n      \n      <div class=\"absolute inset-0 border border-[var(--primary-glow)]/10 rounded-full scale-110\" data-kid=\"20\"></div>\n      <div class=\"absolute inset-0 border border-[var(--primary-glow)]/5 rounded-full scale-125\" data-kid=\"21\"></div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"features\" class=\"relative w-full h-[950px] flex flex-col items-center justify-center overflow-hidden bg-black/20\" data-kid=\"22\">\n  <div class=\"absolute inset-0 opacity-10\" style=\"background-image: radial-gradient(circle, var(--primary-glow) 1px, transparent 1px); background-size: 40px 40px;\" data-kid=\"23\"></div>\n  \n  <div class=\"absolute top-24 text-center z-30\" data-kid=\"24\">\n    <h2 class=\"font-heading text-5xl font-bold mb-4 tracking-tight\" data-kid=\"25\">SYSTEM TOPOLOGY</h2>\n    <p class=\"text-[var(--primary-glow)]/60 font-medium tracking-[0.2em] uppercase text-xs\" data-kid=\"26\">Autonomous Orchestration Map</p>\n  </div>\n\n  <div class=\"relative w-[1000px] h-[1000px] flex items-center justify-center z-10\" data-kid=\"27\">\n    \n    <div class=\"absolute w-[450px] h-[450px] border border-[var(--primary-glow)]/20 rounded-full\" data-kid=\"28\"></div>\n    <div class=\"absolute w-[750px] h-[750px] border border-[var(--primary-glow)]/10 rounded-full\" data-kid=\"29\"></div>\n\n    \n    <div class=\"relative z-50 w-48 h-48 spatial-glass rounded-[40px] flex flex-col items-center justify-center border-2 border-[var(--primary-glow)] shadow-[0_0_50px_rgba(125,249,255,0.3)]\" data-kid=\"30\">\n      <i class=\"ti ti-cpu text-7xl text-[var(--primary-glow)] drop-shadow-[0_0_15px_var(--primary-glow)] mb-2\" data-kid=\"31\"></i>\n      <span class=\"font-heading text-[10px] font-bold tracking-[0.3em] text-[var(--primary-glow)]\" data-kid=\"32\">CORE O.S.</span>\n    </div>\n\n    \n    <div class=\"orbit-wrapper\" style=\"--duration: 30s; animation-name: orbit-rotate-0;\" data-kid=\"33\">\n      <div class=\"orbital-card w-44\" style=\"--distance: 225px;\" data-kid=\"34\">\n        <div class=\"orbital-card-content p-5 spatial-glass rounded-2xl flex flex-col items-center text-center border-[var(--primary-glow)]/20 hover:border-[var(--primary-glow)]/60 transition-all\" data-kid=\"35\">\n          <i class=\"ti ti-zap text-3xl text-[var(--primary-glow)] mb-3\" data-kid=\"36\"></i>\n          <h4 class=\"font-heading font-bold text-sm text-white mb-1\" data-kid=\"37\">Ultra Latency</h4>\n          <p class=\"text-[10px] text-white/50 leading-relaxed\" data-kid=\"38\">Sub-millisecond spatial propagation.</p>\n        </div>\n      </div>\n    </div>\n    <div class=\"orbit-wrapper\" style=\"--duration: 30s; animation-name: orbit-rotate-120;\" data-kid=\"39\">\n      <div class=\"orbital-card w-44\" style=\"--distance: 225px;\" data-kid=\"40\">\n        <div class=\"orbital-card-content p-5 spatial-glass rounded-2xl flex flex-col items-center text-center border-[var(--primary-glow)]/20 hover:border-[var(--primary-glow)]/60 transition-all\" data-kid=\"41\">\n          <i class=\"ti ti-shield-lock text-3xl text-[var(--primary-glow)] mb-3\" data-kid=\"42\"></i>\n          <h4 class=\"font-heading font-bold text-sm text-white mb-1\" data-kid=\"43\">Cryo-Sec</h4>\n          <p class=\"text-[10px] text-white/50 leading-relaxed\" data-kid=\"44\">End-to-end volumetric encryption.</p>\n        </div>\n      </div>\n    </div>\n    <div class=\"orbit-wrapper\" style=\"--duration: 30s; animation-name: orbit-rotate-240;\" data-kid=\"45\">\n      <div class=\"orbital-card w-44\" style=\"--distance: 225px;\" data-kid=\"46\">\n        <div class=\"orbital-card-content p-5 spatial-glass rounded-2xl flex flex-col items-center text-center border-[var(--primary-glow)]/20 hover:border-[var(--primary-glow)]/60 transition-all\" data-kid=\"47\">\n          <i class=\"ti ti-user-cog text-3xl text-[var(--primary-glow)] mb-3\" data-kid=\"48\"></i>\n          <h4 class=\"font-heading font-bold text-sm text-white mb-1\" data-kid=\"49\">Human-In-Loop</h4>\n          <p class=\"text-[10px] text-white/50 leading-relaxed\" data-kid=\"50\">Neural-mapped manual override.</p>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"orbit-wrapper\" style=\"--duration: 50s; animation-name: orbit-rotate-60;\" data-kid=\"51\">\n      <div class=\"orbital-card w-48\" style=\"--distance: 375px;\" data-kid=\"52\">\n        <div class=\"orbital-card-content p-6 bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl flex flex-col items-center text-center hover:border-[var(--primary-glow)]/40 transition-all\" data-kid=\"53\">\n          <i class=\"ti ti-device-computer-camera text-3xl text-[var(--primary-glow)] mb-3\" data-kid=\"54\"></i>\n          <h4 class=\"font-heading font-bold text-sm text-white mb-1\" data-kid=\"55\">Spatial Viz</h4>\n          <p class=\"text-[10px] text-white/50 leading-relaxed\" data-kid=\"56\">Interactive 3D viewport navigation.</p>\n        </div>\n      </div>\n    </div>\n    <div class=\"orbit-wrapper\" style=\"--duration: 50s; animation-name: orbit-rotate-180;\" data-kid=\"57\">\n      <div class=\"orbital-card w-48\" style=\"--distance: 375px;\" data-kid=\"58\">\n        <div class=\"orbital-card-content p-6 bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl flex flex-col items-center text-center hover:border-[var(--primary-glow)]/40 transition-all\" data-kid=\"59\">\n          <i class=\"ti ti-layout-distribute-horizontal text-3xl text-[var(--primary-glow)] mb-3\" data-kid=\"60\"></i>\n          <h4 class=\"font-heading font-bold text-sm text-white mb-1\" data-kid=\"61\">Auto-Scaling</h4>\n          <p class=\"text-[10px] text-white/50 leading-relaxed\" data-kid=\"62\">Infinite cluster expansion capability.</p>\n        </div>\n      </div>\n    </div>\n    <div class=\"orbit-wrapper\" style=\"--duration: 50s; animation-name: orbit-rotate-300;\" data-kid=\"63\">\n      <div class=\"orbital-card w-48\" style=\"--distance: 375px;\" data-kid=\"64\">\n        <div class=\"orbital-card-content p-6 bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl flex flex-col items-center text-center hover:border-[var(--primary-glow)]/40 transition-all\" data-kid=\"65\">\n          <i class=\"ti ti-shredder text-3xl text-[var(--primary-glow)] mb-3\" data-kid=\"66\"></i>\n          <h4 class=\"font-heading font-bold text-sm text-white mb-1\" data-kid=\"67\">Memory Purge</h4>\n          <p class=\"text-[10px] text-white/50 leading-relaxed\" data-kid=\"68\">Real-time purging for 100% uptime.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"analytics\" class=\"relative w-full h-[850px] flex flex-col items-center justify-center px-24 border-t border-white/5\" data-kid=\"69\">\n  <div class=\"mb-20 text-center\" data-kid=\"70\">\n    <h2 class=\"font-heading text-6xl font-bold mb-4\" data-kid=\"71\">LAYERED ANALYTICS</h2>\n    <p class=\"text-white/40 max-w-lg mx-auto font-light\" data-kid=\"72\">Deep inspection of spatial network performance through multi-layered volumetric cards.</p>\n  </div>\n\n  <div class=\"relative w-full max-w-5xl h-[450px]\" data-kid=\"73\">\n    \n    <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-[90%] h-full bg-white/2 backdrop-blur-[40px] border border-white/5 rounded-[40px] translate-y-16 scale-90 opacity-20\" data-kid=\"74\"></div>\n    <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-[95%] h-full bg-white/3 backdrop-blur-[30px] border border-white/10 rounded-[40px] translate-y-8 scale-95 opacity-50\" data-kid=\"75\"></div>\n    \n    \n    <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-full h-full spatial-glass rounded-[40px] p-12 flex flex-col shadow-2xl overflow-hidden border-white/20\" data-kid=\"76\">\n      \n      <div class=\"absolute top-6 left-6 w-8 h-8 border-t-2 border-l-2 border-[var(--primary-glow)]/40 rounded-tl-lg\" data-kid=\"77\"></div>\n      <div class=\"absolute top-6 right-6 w-8 h-8 border-t-2 border-r-2 border-[var(--primary-glow)]/40 rounded-tr-lg\" data-kid=\"78\"></div>\n      <div class=\"absolute bottom-6 left-6 w-8 h-8 border-b-2 border-l-2 border-[var(--primary-glow)]/40 rounded-bl-lg\" data-kid=\"79\"></div>\n      <div class=\"absolute bottom-6 right-6 w-8 h-8 border-b-2 border-r-2 border-[var(--primary-glow)]/40 rounded-br-lg\" data-kid=\"80\"></div>\n\n      <div class=\"flex items-start justify-between mb-12\" data-kid=\"81\">\n        <div class=\"flex items-center gap-6\" data-kid=\"82\">\n          <div class=\"p-4 bg-[var(--primary-glow)]/10 rounded-2xl border border-[var(--primary-glow)]/20\" data-kid=\"83\">\n            <i class=\"ti ti-activity-heartbeat text-4xl text-[var(--primary-glow)]\" data-kid=\"84\"></i>\n          </div>\n          <div data-kid=\"85\">\n            <h3 class=\"font-heading text-2xl font-bold text-white\" data-kid=\"86\">Spatial Flux Density</h3>\n            <p class=\"text-sm text-[var(--primary-glow)]/60 font-medium\" data-kid=\"87\">REAL-TIME TELEMETRY FEED</p>\n          </div>\n        </div>\n        <div class=\"flex gap-12 text-right\" data-kid=\"88\">\n          <div data-kid=\"89\">\n            <div class=\"text-[10px] text-white/30 uppercase tracking-[0.2em] mb-1\" data-kid=\"90\">Node Load</div>\n            <div class=\"font-heading text-2xl font-bold text-white\" data-kid=\"91\">84.2<span class=\"text-xs text-white/40 ml-1\" data-kid=\"92\">%</span></div>\n          </div>\n          <div data-kid=\"93\">\n            <div class=\"text-[10px] text-white/30 uppercase tracking-[0.2em] mb-1\" data-kid=\"94\">Bandwidth</div>\n            <div class=\"font-heading text-2xl font-bold text-white\" data-kid=\"95\">12.8<span class=\"text-xs text-white/40 ml-1\" data-kid=\"96\">PB/s</span></div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"flex-1 w-full relative\" data-kid=\"97\">\n        <svg class=\"w-full h-full overflow-visible\" viewBox=\"0 0 1000 250\" preserveAspectRatio=\"none\" data-kid=\"98\">\n          <defs data-kid=\"99\">\n            <linearGradient id=\"chart-grad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\" data-kid=\"100\">\n              <stop offset=\"0%\" stop-color=\"#7DF9FF\" stop-opacity=\"0.2\" data-kid=\"101\"></stop>\n              <stop offset=\"100%\" stop-color=\"#7DF9FF\" stop-opacity=\"0\" data-kid=\"102\"></stop>\n            </linearGradient>\n            <filter id=\"glow\" data-kid=\"103\">\n              <feGaussianBlur stdDeviation=\"3\" result=\"coloredBlur\" data-kid=\"104\"></feGaussianBlur>\n              <feMerge data-kid=\"105\">\n                <feMergeNode in=\"coloredBlur\" data-kid=\"106\"></feMergeNode>\n                <feMergeNode in=\"SourceGraphic\" data-kid=\"107\"></feMergeNode>\n              </feMerge>\n            </filter>\n          </defs>\n          \n          <line x1=\"0\" y1=\"50\" x2=\"1000\" y2=\"50\" stroke=\"white\" stroke-opacity=\"0.05\" data-kid=\"108\"></line>\n          <line x1=\"0\" y1=\"100\" x2=\"1000\" y2=\"100\" stroke=\"white\" stroke-opacity=\"0.05\" data-kid=\"109\"></line>\n          <line x1=\"0\" y1=\"150\" x2=\"1000\" y2=\"150\" stroke=\"white\" stroke-opacity=\"0.05\" data-kid=\"110\"></line>\n          <line x1=\"0\" y1=\"200\" x2=\"1000\" y2=\"200\" stroke=\"white\" stroke-opacity=\"0.05\" data-kid=\"111\"></line>\n          \n          <path d=\"M0 200 Q 100 180, 200 210 T 400 120 T 600 160 T 800 80 T 1000 110 L 1000 250 L 0 250 Z\" fill=\"url(#chart-grad)\" data-kid=\"112\"></path>\n          <path d=\"M0 200 Q 100 180, 200 210 T 400 120 T 600 160 T 800 80 T 1000 110\" fill=\"none\" stroke=\"var(--primary-glow)\" stroke-width=\"3\" stroke-linecap=\"round\" filter=\"url(#glow)\" data-kid=\"113\"></path>\n        </svg>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"proof\" class=\"relative w-full h-[850px] flex items-center bg-black/30 overflow-hidden border-t border-white/5\" data-kid=\"114\">\n  <div class=\"absolute inset-0 opacity-5 pointer-events-none\" style=\"background-image: radial-gradient(circle, var(--primary-glow) 1px, transparent 1px); background-size: 60px 60px;\" data-kid=\"115\"></div>\n  \n  <div class=\"pl-24 w-1/2 relative z-10\" data-kid=\"116\">\n    <h2 class=\"font-heading text-6xl font-bold mb-6\" data-kid=\"117\">VALIDATED BY<br data-kid=\"118\"><span class=\"text-[var(--primary-glow)] glow-text\" data-kid=\"119\">PIONEERS</span></h2>\n    <p class=\"text-xl text-white/50 font-light max-w-md leading-relaxed mb-12\" data-kid=\"120\">\n      Industry leaders trust the Consensus Layer for mission-critical operations.\n    </p>\n\n    \n    <div class=\"grid grid-cols-2 gap-6 max-w-md\" data-kid=\"121\">\n      <div class=\"p-6 spatial-glass rounded-2xl border-white/5\" data-kid=\"122\">\n        <div class=\"text-[10px] text-white/30 uppercase tracking-[0.2em] mb-2\" data-kid=\"123\">Cluster Nodes</div>\n        <div class=\"font-heading text-3xl font-bold text-[var(--primary-glow)]\" data-kid=\"124\">1,402</div>\n        <div class=\"flex items-center gap-1 mt-2\" data-kid=\"125\">\n          <div class=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse\" data-kid=\"126\"></div>\n          <span class=\"text-[10px] text-emerald-500\" data-kid=\"127\">SYSTEM OPERATIONAL</span>\n        </div>\n      </div>\n      <div class=\"p-6 spatial-glass rounded-2xl border-white/5\" data-kid=\"128\">\n        <div class=\"text-[10px] text-white/30 uppercase tracking-[0.2em] mb-2\" data-kid=\"129\">Total Throughput</div>\n        <div class=\"font-heading text-3xl font-bold text-white\" data-kid=\"130\">4.2 <span class=\"text-sm opacity-30\" data-kid=\"131\">EB/s</span></div>\n        <div class=\"w-full h-1 bg-white/5 rounded-full mt-4 overflow-hidden\" data-kid=\"132\">\n          <div class=\"w-2/3 h-full bg-[var(--primary-glow)] rounded-full\" data-kid=\"133\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"absolute bottom-16 right-16 flex flex-col items-end\" data-kid=\"134\">\n    \n    <div class=\"w-[420px] p-8 bg-white/5 backdrop-blur-sm border border-white/5 rounded-3xl mb-[-50px] translate-x-12 opacity-30 scale-90 z-0\" data-kid=\"135\">\n      <div class=\"flex items-center gap-4 mb-4\" data-kid=\"136\">\n        <div class=\"w-10 h-10 rounded-full bg-gray-600/50\" data-kid=\"137\"></div>\n        <div class=\"text-xs font-bold text-white tracking-widest uppercase opacity-40\" data-kid=\"138\">System Node #042</div>\n      </div>\n      <p class=\"text-sm text-white/30 italic\" data-kid=\"139\">\"Global latency convergence within 5ms...\"</p>\n    </div>\n\n    \n    <div class=\"w-[420px] p-8 bg-white/10 backdrop-blur-md border border-white/10 rounded-3xl mb-[-50px] translate-x-6 opacity-60 scale-95 z-10\" data-kid=\"140\">\n      <div class=\"flex items-center gap-4 mb-4\" data-kid=\"141\">\n        <div class=\"w-10 h-10 rounded-full border border-white/20 overflow-hidden\" data-kid=\"142\">\n          <img src=\"https://i.pravatar.cc/100?u=tech\" alt=\"User\" decoding=\"async\" loading=\"lazy\" data-kid=\"143\">\n        </div>\n        <div data-kid=\"144\">\n          <div class=\"text-sm font-bold text-white\" data-kid=\"145\">DevOps Lead</div>\n          <div class=\"text-[10px] text-white/40 uppercase tracking-widest\" data-kid=\"146\">Quantum Logistics</div>\n        </div>\n      </div>\n      <p class=\"text-sm text-white/60\" data-kid=\"147\">\"Reduced our orchestration overhead by 72% since migration.\"</p>\n    </div>\n\n    \n    <div class=\"w-[450px] p-10 spatial-glass rounded-[32px] border-white/30 shadow-[0_30px_60px_-12px_rgba(0,0,0,0.5)] z-20 hover:-translate-y-4 transition-transform duration-500 cursor-default\" data-kid=\"148\">\n      <div class=\"flex items-center gap-5 mb-6\" data-kid=\"149\">\n        <div class=\"w-16 h-16 rounded-full border-2 border-[var(--primary-glow)] overflow-hidden p-0.5\" data-kid=\"150\">\n          <img src=\"https://i.pravatar.cc/100?u=sarah\" class=\"w-full h-full rounded-full object-cover\" alt=\"Sarah Chen\" decoding=\"async\" loading=\"lazy\" data-kid=\"151\">\n        </div>\n        <div data-kid=\"152\">\n          <h4 class=\"font-heading text-xl font-bold text-white\" data-kid=\"153\">Sarah Chen</h4>\n          <div class=\"text-xs text-[var(--primary-glow)] font-bold tracking-[0.2em] uppercase\" data-kid=\"154\">CTO @ NEURONICS</div>\n        </div>\n      </div>\n      <p class=\"text-lg text-white/90 font-light leading-relaxed mb-8\" data-kid=\"155\">\n        \"Cut latency by <span class=\"text-[var(--primary-glow)] font-bold\" data-kid=\"156\">40ms</span> across our entire cluster. The volumetric visualization provides insights we simply couldn't see in 2D.\"\n      </p>\n      <div class=\"flex items-center justify-between border-t border-white/10 pt-6\" data-kid=\"157\">\n        <div class=\"flex items-center gap-2\" data-kid=\"158\">\n          <i class=\"ti ti-chart-arrows text-[var(--primary-glow)]\" data-kid=\"159\"></i>\n          <span class=\"text-[10px] font-bold text-white/40 uppercase tracking-widest\" data-kid=\"160\">Metric: Peak Latency reduction</span>\n        </div>\n        <div class=\"flex gap-0.5\" data-kid=\"161\">\n          <i class=\"ti ti-star-filled text-[var(--primary-glow)] text-xs\" data-kid=\"162\"></i>\n          <i class=\"ti ti-star-filled text-[var(--primary-glow)] text-xs\" data-kid=\"163\"></i>\n          <i class=\"ti ti-star-filled text-[var(--primary-glow)] text-xs\" data-kid=\"164\"></i>\n          <i class=\"ti ti-star-filled text-[var(--primary-glow)] text-xs\" data-kid=\"165\"></i>\n          <i class=\"ti ti-star-filled text-[var(--primary-glow)] text-xs\" data-kid=\"166\"></i>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"closing\" class=\"peephole-parent relative w-full h-[900px] flex items-center justify-center overflow-hidden bg-black font-heading border-t border-white/5\" data-kid=\"167\">\n  <div class=\"absolute inset-0 opacity-10 cyber-scanlines\" data-kid=\"168\"></div>\n  \n  <div class=\"absolute inset-0 bg-[var(--bg-color)] z-0\" data-kid=\"169\"></div>\n  \n  \n  <div class=\"peephole-window relative w-[700px] h-[700px] rounded-full overflow-hidden z-10 transition-all duration-1000 ease-in-out border-4 border-[var(--primary-glow)]/20 shadow-[0_0_120px_rgba(0,0,0,0.9)_inset]\" data-kid=\"170\">\n    <video src=\"https://videos.pexels.com/video-files/34336322/14545802_360_640_30fps.mp4\" poster=\"https://images.pexels.com/videos/34336322/pexels-photo-34336322.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=1200&w=630\" autoplay muted loop playsinline preload=\"metadata\" class=\"absolute inset-0 w-full h-full object-cover scale-110\" data-kid=\"171\"></video>\n    \n    \n    <div class=\"absolute inset-0 bg-black/40\" data-kid=\"172\"></div>\n\n    \n    <div class=\"absolute inset-0 flex flex-col items-center justify-center text-center p-12 z-20\" data-kid=\"173\">\n      <h2 class=\"text-7xl font-bold text-white mb-6 tracking-tighter drop-shadow-[0_10px_30px_rgba(0,0,0,0.5)] leading-tight\" data-kid=\"174\">\n        REDEFINE THE<br data-kid=\"175\"><span class=\"text-[var(--primary-glow)] glow-text\" data-kid=\"176\">POSSIBLE</span>\n      </h2>\n      <p class=\"text-xl text-white/90 font-light max-w-2xl mb-10 font-['Fira_Sans'] leading-relaxed\" data-kid=\"177\">\n        The spatial revolution is here. Don't build for the past. \n        Initialize your instance and start navigating the consensus layer today.\n      </p>\n      \n      <button class=\"px-16 py-6 bg-[var(--cta-accent)] text-white text-2xl font-bold rounded-full shadow-[0_0_50px_rgba(222,49,99,0.6)] hover:scale-110 active:scale-95 transition-all duration-300 border-2 border-white/20\" data-kid=\"178\">\n        LAUNCH YOUR INSTANCE\n      </button>\n      \n      <div class=\"mt-12 flex flex-wrap justify-center gap-x-10 gap-y-4 items-center text-white/60 font-['Fira_Sans'] text-sm\" data-kid=\"179\">\n        <span class=\"flex items-center gap-2\" data-kid=\"180\"><i class=\"ti ti-circle-check text-[var(--primary-glow)]\" data-kid=\"181\"></i> Zero setup fee</span>\n        <span class=\"flex items-center gap-2\" data-kid=\"182\"><i class=\"ti ti-circle-check text-[var(--primary-glow)]\" data-kid=\"183\"></i> Free node migration</span>\n        <span class=\"flex items-center gap-2\" data-kid=\"184\"><i class=\"ti ti-circle-check text-[var(--primary-glow)]\" data-kid=\"185\"></i> 24/7 Neural support</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<footer class=\"relative w-full py-12 px-24 bg-black/50 border-t border-white/5 flex items-center justify-between\" data-kid=\"186\">\n  <div class=\"flex items-center gap-12\" data-kid=\"187\">\n    <div class=\"flex items-center gap-3\" data-kid=\"188\">\n      <div class=\"w-10 h-10 bg-[var(--primary-glow)]/10 border border-[var(--primary-glow)]/30 rounded-lg flex items-center justify-center\" data-kid=\"189\">\n        <i class=\"ti ti-brand-abstract text-[var(--primary-glow)] text-xl\" data-kid=\"190\"></i>\n      </div>\n      <span class=\"font-heading font-bold text-xl tracking-tighter\" data-kid=\"191\">CONSENSUS</span>\n    </div>\n    <div class=\"flex gap-8 text-sm text-white/30 uppercase tracking-widest font-medium\" data-kid=\"192\">\n      <a href=\"#\" class=\"hover:text-[var(--primary-glow)] transition-colors\" data-kid=\"193\">Documentation</a>\n      <a href=\"#\" class=\"hover:text-[var(--primary-glow)] transition-colors\" data-kid=\"194\">Network Map</a>\n      <a href=\"#\" class=\"hover:text-[var(--primary-glow)] transition-colors\" data-kid=\"195\">Safety Standard</a>\n    </div>\n  </div>\n  <div class=\"flex items-center gap-8\" data-kid=\"196\">\n    <div class=\"flex gap-4\" data-kid=\"197\">\n      <a href=\"#\" class=\"w-10 h-10 rounded-full spatial-glass flex items-center justify-center hover:bg-[var(--primary-glow)]/10 transition-colors\" data-kid=\"198\"><i class=\"ti ti-brand-twitter\" data-kid=\"199\"></i></a>\n      <a href=\"#\" class=\"w-10 h-10 rounded-full spatial-glass flex items-center justify-center hover:bg-[var(--primary-glow)]/10 transition-colors\" data-kid=\"200\"><i class=\"ti ti-brand-discord\" data-kid=\"201\"></i></a>\n      <a href=\"#\" class=\"w-10 h-10 rounded-full spatial-glass flex items-center justify-center hover:bg-[var(--primary-glow)]/10 transition-colors\" data-kid=\"202\"><i class=\"ti ti-brand-github\" data-kid=\"203\"></i></a>\n    </div>\n    <span class=\"text-xs text-white/20\" data-kid=\"204\">© 2026 SPATIAL OVERLAY SYSTEMS</span>\n  </div>\n</footer>\n\n<script data-kid=\"205\">\n  // Custom Cursor Logic\n  const cursor = document.getElementById('custom-cursor');\n  document.addEventListener('mousemove', (e) => {\n    cursor.style.left = e.pageX + 'px';\n    cursor.style.top = e.pageY + 'px';\n  });\n\n  // Magnetic Button Logic\n  const setupMagnetic = (btnId, wrapId) => {\n    const btn = document.getElementById(btnId);\n    const wrap = document.getElementById(wrapId);\n    \n    wrap.addEventListener('mousemove', (e) => {\n      const rect = wrap.getBoundingClientRect();\n      const x = e.clientX - rect.left - rect.width / 2;\n      const y = e.clientY - rect.top - rect.height / 2;\n      \n      btn.style.transform = `translate(${x * 0.4}px, ${y * 0.4}px)`;\n      cursor.classList.add('cursor-active');\n    });\n    \n    wrap.addEventListener('mouseleave', () => {\n      btn.style.transform = `translate(0, 0)`;\n      cursor.classList.remove('cursor-active');\n    });\n  };\n\n  setupMagnetic('mag-hero-btn', 'mag-hero-wrap');\n</script>\n",
